# Copy to .env and fill in. Everything is optional: with no keys the app runs in
# offline demo mode (rule engine only, replies printed to the console).

# --- LLM (optional, improves explanations for borderline messages) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- WhatsApp: pick ONE provider ---
# WHATSAPP_PROVIDER = console | meta | twilio
WHATSAPP_PROVIDER=console

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=surakshasathi-verify
META_ACCESS_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Link safety (optional) ---
GOOGLE_SAFE_BROWSING_KEY=

# --- Speech ---
# Text-to-speech uses gTTS (no key). Speech-to-text uses a local faster-whisper
# install if present, otherwise the OpenAI Whisper API when this key is set.
OPENAI_API_KEY=

# --- Admin / demo ---
# ADMIN_TOKEN protects /admin/* (daily lesson broadcast). DEMO_MODE=1 enables the
# dashboard's "simulate a WhatsApp message" box and /api/demo/* endpoints. Set it to 0 in production.
ADMIN_TOKEN=change-me
DEMO_MODE=1

# Public base URL of this server (used to serve generated audio to WhatsApp)
PUBLIC_BASE_URL=http://localhost:8000

# --- Storage ---
DATABASE_PATH=data/surakshasathi.db
